<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <solid android:color="#FFFFFF"/>

            <stroke
                android:width="2dp"
                android:color="#1565C0"/>

            <corners android:radius="100dp"/>
        </shape>
    </item>

    <item
        android:left="5dp"
        android:right="5dp"
        android:top="5dp"
        android:bottom="5dp">

        <shape>
            <solid android:color="#1565C0"/>
            <corners android:radius="100dp"/>
        </shape>

    </item>

</layer-list>