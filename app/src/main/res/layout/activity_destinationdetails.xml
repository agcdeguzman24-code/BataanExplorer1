<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <!-- ========================= -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="105dp">

        <!-- DITO LAHAT NG CURRENT CONTENT MO -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

        <!-- ========================= -->
        <!-- TOP / HERO IMAGE -->
        <!-- ========================= -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPlace"
            android:layout_width="0dp"
            android:layout_height="280dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/quiz_bg3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/TopImageRounded" />

            <!-- ================= CLOSE BUTTON ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCloseQuiz"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="50dp"
                app:cardBackgroundColor="#F3F6FA"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="×"
                    android:textColor="#374151"
                    android:textSize="22sp"
                    app:backgroundTint="#F3F6FA"
                    app:cornerRadius="21dp"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================= -->
            <!-- FAVORITE BUTTON -->
            <!-- ========================= -->

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="33dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Favorite"
                android:padding="12dp"
                android:src="@drawable/ic_favorite_outline"
                app:tint="#17213A"
                app:layout_constraintEnd_toEndOf="@id/imgPlace"
                app:layout_constraintTop_toTopOf="@id/imgPlace" />

            <!-- ========================= -->
            <!-- RATING BADGE -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/ratingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rating_badge_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                app:layout_constraintBottom_toBottomOf="@id/imgPlace"
                app:layout_constraintEnd_toEndOf="@id/imgPlace">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="Rating"
                    android:src="@drawable/ic_star_filled" />

                <TextView
                    android:id="@+id/txtImageRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.9"
                    android:textColor="#17213A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        <!-- ========================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgPlace">


            <!-- ========================= -->
            <!-- CATEGORY + OPEN STATUS -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_historical_bg"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="6dp"
                    android:text="HISTORICAL"
                    android:textColor="#2469D8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtOpenStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/chip_open_bg"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="6dp"
                    android:text="OPEN NOW"
                    android:textColor="#22A56A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- PLACE NAME -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtPlaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mt. Samat National Shrine"
                android:textColor="#17213A"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- ========================= -->
            <!-- LOCATION -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:id="@+id/txtLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Pilar, Bataan, Philippines"
                    android:textColor="#536078"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- RATING -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Star" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Star" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Star" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Star" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Star" />

                <TextView
                    android:id="@+id/txtRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="4.9"
                    android:textColor="#17213A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="(2,481 reviews)"
                    android:textColor="#7B879B"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- SPACE -->
            <!-- ========================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />


            <!-- ========================= -->
            <!-- PHOTOS -->
            <!-- DATABASE WILL BE ADDED LATER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPhotosTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Photos"
                    android:textColor="#17213A"
                    android:textSize="18sp"
                    android:textStyle="bold" />



            </LinearLayout>


            <!-- ========================= -->
            <!-- PHOTOS HORIZONTAL GALLERY -->
            <!-- ========================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/photosContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Photo Card 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="130dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgExtraPhoto1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/quiz_bg3"
                            android:contentDescription="Extra photo 1" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Photo Card 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="130dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgExtraPhoto2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/quiz_bg3"
                            android:contentDescription="Extra photo 2" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Photo Card 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="130dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgExtraPhoto3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/quiz_bg3"
                            android:contentDescription="Extra photo 3" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>


            <!-- ========================= -->
            <!-- SPACE BEFORE DESCRIPTION -->
            <!-- ========================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />


            <!-- ========================= -->
            <!-- DESCRIPTION -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtDescriptionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#17213A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="Mt. Samat National Shrine is one of Bataan's most important historical landmarks, honoring the Filipino and American soldiers who fought during World War II. It is known for its historical significance and panoramic views."
                android:textColor="#536078"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Read More"
                android:textColor="#2469D8"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ========================= -->
            <!-- SPACE -->
            <!-- ========================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />


            <!-- ========================= -->
            <!-- VISITOR INFORMATION -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtVisitorInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visitor Information"
                android:textColor="#17213A"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ========================= -->
            <!-- VISITOR INFO CARD -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/visitor_info_card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">


                <!-- ENTRY FEE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/info_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_money"
                        android:contentDescription="Entrance fee" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Entrance Fee"
                            android:textColor="#7B879B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtEntranceFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="₱50 per person"
                            android:textColor="#17213A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E9EDF4" />


                <!-- OPERATING HOURS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/info_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_clock"
                        android:contentDescription="Operating hours" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Operating Hours"
                            android:textColor="#7B879B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtOperatingHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="6:00 AM – 6:00 PM"
                            android:textColor="#17213A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E9EDF4" />


                <!-- LOCATION -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/info_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_location"
                        android:contentDescription="Location" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textColor="#7B879B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtVisitorLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Pilar, Bataan"
                            android:textColor="#17213A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>



                </LinearLayout>

                <!-- ========================= -->
                <!-- REVIEWS -->
                <!-- ========================= -->



                <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtReviewsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reviews"
                        android:textColor="#17213A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSeeAllPhotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See all"
                        android:textColor="#2469D8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <!-- USER REVIEW 1 -->

                <LinearLayout
                    android:id="@+id/reviewItem1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- USER PROFILE -->

                        <ImageView
                            android:id="@+id/imgReviewUser1"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/info_icon_bg"
                            android:padding="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/profile"
                            android:contentDescription="Reviewer profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtReviewerName1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maria Santos"
                                android:textColor="#17213A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtReviewDate1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="2 weeks ago"
                                android:textColor="#8A94A6"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- STAR RATING -->

                        <TextView
                            android:id="@+id/txtReviewRating1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★ 5.0"
                            android:textColor="#F4B740"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtReviewText1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Beautiful place with an amazing historical atmosphere. The view from the top was also worth the trip!"
                        android:textColor="#536078"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#E9EDF4" />


                <!-- USER REVIEW 2 -->

                <LinearLayout
                    android:id="@+id/reviewItem2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgReviewUser2"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/info_icon_bg"
                            android:padding="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/profile"
                            android:contentDescription="Reviewer profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtReviewerName2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="John Reyes"
                                android:textColor="#17213A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtReviewDate2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="1 month ago"
                                android:textColor="#8A94A6"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtReviewRating2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★ 4.8"
                            android:textColor="#F4B740"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtReviewText2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="A great place to visit if you are interested in Bataan's history. Definitely recommend visiting early."
                        android:textColor="#536078"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#E9EDF4" />

            </LinearLayout>

        </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
        <!-- ================= FLOATING ACTION BAR ================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:translationY="320dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="36dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">


                <!-- ================= FAVORITE ================= -->

                <LinearLayout
                    android:id="@+id/actionFavorite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgActionFavorite"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="Favorite"
                        android:src="@drawable/favorite"
                        app:tint="#536078" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Favorite"
                        android:textColor="#536078"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="#E9EDF4" />


                <!-- ================= DIRECTIONS ================= -->

                <LinearLayout
                    android:id="@+id/actionDirections"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgActionDirections"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="Directions"
                        android:src="@drawable/location"
                        app:tint="#2469D8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Directions"
                        android:textColor="#2469D8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="#E9EDF4" />


                <!-- ================= ADD TO PLANNER ================= -->

                <LinearLayout
                    android:id="@+id/actionAddPlanner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.35"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgActionPlanner"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="Add to Travel Planner"
                        android:src="@drawable/planner"
                        app:tint="#2469D8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Add to Planner"
                        android:textColor="#2469D8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>