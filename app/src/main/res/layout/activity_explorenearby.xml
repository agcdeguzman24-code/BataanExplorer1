<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <!-- ================================================= -->
    <!-- SCROLLABLE PAGE -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/scrollNearby"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="#FFFFFF">

                <!-- ================= CLOSE BUTTON ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCloseQuiz"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    app:cardBackgroundColor="#F3F6FA"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseQuiz"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="×"
                        android:textColor="#374151"
                        android:textSize="22sp"
                        app:backgroundTint="#F3F6FA"
                        app:cornerRadius="21dp"/>

                </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:id="@+id/txtExploreNearby"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Explore Nearby"
                    android:textColor="#17213A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MAP PLACEHOLDER -->
            <!-- DATABASE / MAP WILL BE ADDED LATER -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="375dp"
                android:background="#CFE3B9">

                <!--
                    MAP DATABASE WILL BE INSERTED HERE LATER.

                    For now this is only a placeholder space.
                    You can replace this FrameLayout with:
                    - Google Map
                    - Firebase locations
                    - Firestore markers
                    - Nearby location data
                -->

                <View
                    android:id="@+id/mapPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CFE3B9" />

                <!-- CURRENT LOCATION BUTTON -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCurrentLocation"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="18dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="5dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:src="@drawable/location"
                        android:contentDescription="Current location"
                        app:tint="#2469D8" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CURRENT LOCATION CARD -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/currentLocationCard"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">


                    <!-- LOCATION ICON -->

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/info_icon_bg"
                        android:padding="11dp"
                        android:src="@drawable/ic_location"
                        android:contentDescription="Current location"
                        app:tint="#2469D8" />


                    <!-- LOCATION TEXT -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Location"
                            android:textColor="#7B879B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtCurrentLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="📍 Dinalupihan, Bataan"
                            android:textColor="#17213A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- LIVE STATUS -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/live_dot_bg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Live"
                            android:textColor="#22A56A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CATEGORY FILTERS -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:id="@+id/categoryScroll"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <!-- ALL -->

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_nearby_bg"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="All"
                        android:textColor="#536078"
                        android:textSize="14sp" />


                    <!-- NATURE -->

                    <TextView
                        android:id="@+id/chipNature"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_nearby_bg"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Nature"
                        android:textColor="#536078"
                        android:textSize="14sp" />


                    <!-- HISTORICAL -->

                    <TextView
                        android:id="@+id/chipHistorical"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_nearby_selected_bg"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Historical"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <!-- BEACH -->

                    <TextView
                        android:id="@+id/chipBeach"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_nearby_bg"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Beach"
                        android:textColor="#536078"
                        android:textSize="14sp" />


                    <!-- ADVENTURE -->

                    <TextView
                        android:id="@+id/chipAdventure"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_nearby_bg"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Adventure"
                        android:textColor="#536078"
                        android:textSize="14sp" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- NEARBY TOURIST SPOTS HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtNearbySpotsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nearby Tourist Spots"
                    android:textColor="#17213A"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNearbyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 places"
                    android:textColor="#7B879B"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- TOURIST SPOT 1 -->
            <!-- DATABASE CONTENT WILL BE ADDED LATER -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nearbyPlace1"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">


                    <!-- PLACE IMAGE PLACEHOLDER -->

                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#DDE8F2" />

                        <!--
                            IMAGE WILL BE LOADED FROM DATABASE LATER
                        -->

                    </FrameLayout>


                    <!-- PLACE INFO -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNearbyName1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mt. Samat"
                            android:textColor="#17213A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNearbyCategory1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Nature · Historical"
                            android:textColor="#7B879B"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <!-- DISTANCE -->

                    <TextView
                        android:id="@+id/txtNearbyDistance1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 km  ›"
                        android:textColor="#2469D8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- TOURIST SPOT 2 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nearbyPlace2"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <!-- IMAGE PLACEHOLDER -->

                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#DDE8F2" />

                    </FrameLayout>


                    <!-- PLACE INFO -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNearbyName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dunsulan Falls"
                            android:textColor="#17213A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNearbyCategory2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Nature · Adventure"
                            android:textColor="#7B879B"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <!-- DISTANCE -->

                    <TextView
                        android:id="@+id/txtNearbyDistance2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 km  ›"
                        android:textColor="#2469D8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- DATABASE SPACE -->
            <!-- ================================================= -->

            <View
                android:id="@+id/nearbyDatabaseSpace"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="18dp"
                android:background="#F5F8FC" />


            <!-- BOTTOM SPACE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>