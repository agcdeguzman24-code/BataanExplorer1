<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= LOADING CONTENT ================= -->

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOADING CIRCLE -->

        <ProgressBar
            android:id="@+id/progressFinding"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#1565C0" />

        <!-- TITLE -->

        <TextView
            android:id="@+id/txtFindingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Finding Your Perfect&#10;Destinations"
            android:textColor="#111827"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- DESCRIPTION -->

        <TextView
            android:id="@+id/txtFindingDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Analyzing your travel preferences..."
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <!-- ================= CHECKLIST ================= -->

        <LinearLayout
            android:id="@+id/layoutChecklist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- TRAVEL PREFERENCES -->

            <LinearLayout
                android:id="@+id/itemTravelPreferences"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/txtTravelPreferences"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Travel preferences"
                    android:textColor="#1565C0"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ACTIVITIES -->

            <LinearLayout
                android:id="@+id/itemActivities"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/txtActivities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Activities"
                    android:textColor="#1565C0"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- BUDGET -->

            <LinearLayout
                android:id="@+id/itemBudget"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/txtBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Budget"
                    android:textColor="#1565C0"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- TRAVEL TIME -->

            <LinearLayout
                android:id="@+id/itemTravelTime"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/txtTravelTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Travel time"
                    android:textColor="#1565C0"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>