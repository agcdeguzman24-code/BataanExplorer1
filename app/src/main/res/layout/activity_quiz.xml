<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">



    <!-- ================= CLOSE BUTTON ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCloseQuiz"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#F3F6FA"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseQuiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="#374151"
            android:textSize="22sp"
            app:backgroundTint="#F3F6FA"
            app:cornerRadius="21dp"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= TOP SECTION ================= -->

        <LinearLayout
            android:id="@+id/layoutQuizHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="78dp"
            android:paddingTop="30dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- QUESTION NUMBER -->

            <TextView
                android:id="@+id/txtQuestionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Question 1 of 8"
                android:textColor="#1565C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- PERCENTAGE -->

            <TextView
                android:id="@+id/txtProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13%"
                android:textColor="#9CA3AF"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- ================= PROGRESS BAR ================= -->

        <ProgressBar
            android:id="@+id/progressQuiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:max="100"
            android:progress="13"
            android:progressTint="#1565C0"
            android:backgroundTint="#E5E7EB"
            app:layout_constraintTop_toBottomOf="@id/layoutQuizHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ================= QUESTION ================= -->

    <TextView
        android:id="@+id/txtQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        android:text="Who are you traveling with?"
        android:textColor="#111827"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressQuiz" />


    <!-- ================= ANSWERS ================= -->

    <!--
        The choices will come from the database.
        RecyclerView will display however many choices
        the current question has.
    -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerQuizOptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtQuestion"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= CONTINUE BUTTON ================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="50dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1565C0"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>