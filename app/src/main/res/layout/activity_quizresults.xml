<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <!-- ================= CLOSE BUTTON ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCloseQuiz"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#F3F6FA"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseQuiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="#374151"
            android:textSize="22sp"
            app:backgroundTint="#F3F6FA"
            app:cornerRadius="21dp"/>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:id="@+id/layoutResultsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="65dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- YOUR RESULTS BADGE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingTop="50dp"
            android:paddingEnd="0dp"
            android:paddingBottom="5dp"
            android:text="YOUR RESULTS"
            android:textColor="#1565C0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- TITLE -->

        <TextView
            android:id="@+id/txtResultsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Your Recommended&#10;Destinations"
            android:textColor="#111827"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- SUBTITLE -->

        <TextView
            android:id="@+id/txtResultsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Based on your travel preferences"
            android:textColor="#6B7280"
            android:textSize="13sp"/>

    </LinearLayout>


    <!-- ================= RESULTS ================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerQuizResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutResultsHeader"
        app:layout_constraintBottom_toTopOf="@id/btnRetakeQuiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ================= RETAKE QUIZ ================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetakeQuiz"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="50dp"
        android:text="Retake Quiz"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1565C0"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>