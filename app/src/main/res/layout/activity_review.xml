<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================= -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ========================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- ================= CLOSE BUTTON ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCloseQuiz"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="50dp"
                app:cardBackgroundColor="#F3F6FA"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="×"
                    android:textColor="#374151"
                    android:textSize="22sp"
                    app:backgroundTint="#F3F6FA"
                    app:cornerRadius="21dp"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================= -->
            <!-- TITLE -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtReviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Review Your Trip"
                android:textColor="#111827"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtReviewSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Share your experience and help other travelers."
                android:textColor="#6B7280"
                android:textSize="13sp" />


            <!-- ========================= -->
            <!-- TRIP CARD -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewedTrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- DESTINATION ICON -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="#EAF2FF"
                        app:cardCornerRadius="23dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="📍"
                            android:textSize="19sp" />

                    </com.google.android.material.card.MaterialCardView>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtReviewDestination"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morong Beach"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtReviewDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="August 15, 2026"
                            android:textColor="#7B879B"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- RATING -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtRatingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="How was your experience?"
                android:textColor="#17213A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRatingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Tap a star to rate your trip."
                android:textColor="#7B879B"
                android:textSize="12sp" />


            <!-- ========================= -->
            <!-- STAR RATING -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/starRatingContainer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/star1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="1 star"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#F4B740" />

                <ImageButton
                    android:id="@+id/star2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="2 stars"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#F4B740" />

                <ImageButton
                    android:id="@+id/star3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="3 stars"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#F4B740" />

                <ImageButton
                    android:id="@+id/star4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="4 stars"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#F4B740" />

                <ImageButton
                    android:id="@+id/star5"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="5 stars"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#F4B740" />



            </LinearLayout>


            <TextView
                android:id="@+id/txtSelectedRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Select a rating"
                android:textColor="#7B879B"
                android:textSize="12sp" />


            <!-- ========================= -->
            <!-- REVIEW -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtWriteReviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Write a Review"
                android:textColor="#17213A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutReviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Tell us about your trip..."
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#9EC5FE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtReview"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:paddingTop="14dp"
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================= -->
            <!-- SUBMIT -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitReview"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Submit Review"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#1565C0"
                app:cornerRadius="14dp" />


            <!-- ========================= -->
            <!-- SKIP -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipReview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="Maybe Later"
                android:textAllCaps="false"
                android:textColor="#1565C0"
                android:textSize="14sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>