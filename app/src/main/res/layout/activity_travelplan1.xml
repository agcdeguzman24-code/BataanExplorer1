<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= CLOSE BUTTON ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCloseQuiz"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#F3F6FA"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseQuiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="#374151"
            android:textSize="22sp"
            app:backgroundTint="#F3F6FA"
            app:cornerRadius="21dp"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= STEP PROGRESS ================= -->

    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:paddingTop="110dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#1565C0"/>

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#E5E7EB"/>

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#E5E7EB"/>

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#E5E7EB"/>

    </LinearLayout>


    <!-- ================= TITLE ================= -->

    <TextView
        android:id="@+id/txtStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="120dp"
        android:text="STEP 1 OF 4"
        android:textColor="#1565C0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="16dp"
        android:text="Create a Trip"
        android:textColor="#111827"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStep"/>

    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="6dp"
        android:text="Choose a municipality to start planning your trip."
        android:textColor="#6B7280"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"/>


    <!-- ================= MUNICIPALITY LIST ================= -->

    <ScrollView
        android:id="@+id/scrollMunicipalities"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/txtDescription"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioGroup
            android:id="@+id/radioMunicipalities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BAGAC -->

            <RadioButton
                android:id="@+id/radioBagac"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Bagac"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- MORONG -->

            <RadioButton
                android:id="@+id/radioMorong"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Morong"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- MARIVELES -->

            <RadioButton
                android:id="@+id/radioMariveles"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Mariveles"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- DINALUPIHAN -->

            <RadioButton
                android:id="@+id/radioDinalupihan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Dinalupihan"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- BALANGA -->

            <RadioButton
                android:id="@+id/radioBalanga"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Balanga"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- PILAR -->

            <RadioButton
                android:id="@+id/radioPilar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Pilar"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- ORION -->

            <RadioButton
                android:id="@+id/radioOrion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Orion"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- LIMAY -->

            <RadioButton
                android:id="@+id/radioLimay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Limay"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- HERMOSA -->

            <RadioButton
                android:id="@+id/radioHermosa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hermosa"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- ORANI -->

            <RadioButton
                android:id="@+id/radioOrani"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Orani"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- SAMAL -->

            <RadioButton
                android:id="@+id/radioSamal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Samal"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

            <!-- ABUCAY -->

            <RadioButton
                android:id="@+id/radioAbucay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_municipality"
                android:buttonTint="#1565C0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Abucay"
                android:textColor="#1F2937"
                android:textSize="14sp"/>

        </RadioGroup>

    </ScrollView>


    <!-- ================= FLOATING CONTINUE ================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="55dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1565C0"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>