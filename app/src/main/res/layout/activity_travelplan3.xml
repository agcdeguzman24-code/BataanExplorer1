<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ================= CLOSE BUTTON ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCloseQuiz"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#F3F6FA"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseQuiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="#374151"
            android:textSize="22sp"
            app:backgroundTint="#F3F6FA"
            app:cornerRadius="21dp"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= STEP PROGRESS ================= -->

    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:paddingTop="110dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#1565C0"/>

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#1565C0"/>

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#1565C0"/>

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#E5E7EB"/>

    </LinearLayout>

    <!-- ================= SCROLLABLE CONTENT ================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPlanTrip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="95dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="30dp"
            android:paddingBottom="20dp">



            <!-- TITLE -->

            <TextView
                android:id="@+id/txtStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="90dp"
                android:text="STEP 3 OF 4"
                android:textColor="#1565C0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Plan Your Trip"
                android:textColor="#111827"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Review and confirm your trip details."
                android:textColor="#6B7280"
                android:textSize="13sp"/>


            <!-- ================= DESTINATION ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDestination"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#EAF2FF"
                app:cardCornerRadius="12dp"
                app:strokeColor="#9EC5FE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESTINATION"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/txtDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Morong Beach"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= TRAVEL DATE ================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTravelDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Travel Date"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="#D1D5DB"
                app:startIconDrawable="@android:drawable/ic_menu_my_calendar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTravelDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:text="August 15, 2026"
                    android:textColor="#111827"
                    android:textSize="16sp"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= ACTIVITY DROPDOWN ================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutActivity"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Activity"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="#D1D5DB"
                app:startIconDrawable="@android:drawable/ic_menu_sort_by_size"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/dropdownActivity"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="none"
                    android:paddingStart="48dp"
                    android:text="Beach"
                    android:textColor="#111827"
                    android:textSize="16sp"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= REMINDER ================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutReminder"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Reminder"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="#D1D5DB"
                app:startIconDrawable="@android:drawable/ic_lock_idle_alarm"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/dropdownReminder"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="none"
                    android:paddingStart="48dp"
                    android:text="1 day before"
                    android:textColor="#111827"
                    android:textSize="16sp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================= FLOATING SAVE BUTTON ================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveTrip"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="55dp"
        android:text="Save Trip"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1565C0"
        app:cornerRadius="16dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>