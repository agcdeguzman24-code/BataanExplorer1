<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ================= CLOSE BUTTON ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCloseQuiz"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#F3F6FA"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseQuiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="#374151"
            android:textSize="22sp"
            app:backgroundTint="#F3F6FA"
            app:cornerRadius="21dp"/>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================= MAIN CONTENT ================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSummary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="60dp"
            android:paddingBottom="30dp">



            <!-- ================= PROGRESS ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="50dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#1565C0"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1565C0"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1565C0"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1565C0"/>

            </LinearLayout>


            <!-- ================= SUCCESS ICON ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#EAF2FF"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#1565C0"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                </com.google.android.material.card.MaterialCardView>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= TITLE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:text="Trip Saved!"
                android:textColor="#111827"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Your trip has been added to your Travel Planner."
                android:textColor="#6B7280"
                android:textSize="13sp"/>


            <!-- ================= TRIP SUMMARY ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTripSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- LABEL -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRIP SUMMARY"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"/>


                    <!-- DESTINATION -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtSummaryDestination"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Morong Beach"
                            android:textColor="#111827"
                            android:textSize="16sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"/>


                    <!-- DATE -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="▣"
                            android:textColor="#1565C0"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/txtSummaryDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="August 15, 2026"
                            android:textColor="#111827"
                            android:textSize="16sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"/>


                    <!-- ACTIVITY -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="⌁"
                            android:textColor="#1565C0"
                            android:textSize="19sp"/>

                        <TextView
                            android:id="@+id/txtSummaryActivity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Beach"
                            android:textColor="#111827"
                            android:textSize="16sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"/>


                    <!-- REMINDER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="♧"
                            android:textColor="#1565C0"
                            android:textSize="17sp"/>

                        <TextView
                            android:id="@+id/txtSummaryReminder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reminder: 1 day before"
                            android:textColor="#111827"
                            android:textSize="16sp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= PLAN ANOTHER TRIP ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanAnotherTrip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Plan Another Trip"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1565C0"
                app:cornerRadius="14dp"/>


            <!-- ================= DONE ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditTrip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Edit Trip"
                android:textAllCaps="false"
                android:textColor="#1565C0"
                android:textSize="16sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="14dp"
                app:strokeColor="#9EC5FE"
                app:strokeWidth="1dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>